# Database Credentials
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian_dev
POSTGRES_DB=guardian

# Sandbox Runtime Configuration
# Options: "runsc" (gVisor, Linux hosts) or "runc" (hardened Docker fallback,
# e.g. Docker Desktop on Windows/macOS where gVisor is not installed)
SANDBOX_RUNTIME=runsc

# Optional: pin sandbox images to exact local image IDs (docker image inspect -f '{{.Id}}' <tag>)
SANDBOX_IMAGE_DIGEST_CLONE=
SANDBOX_IMAGE_DIGEST_RESOLVE=
SANDBOX_IMAGE_DIGEST_SCAN=
SANDBOX_IMAGE_DIGEST_VERIFY=

# Shared secret for service-to-service calls (orchestrator <-> launcher, scanner-intel).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_TOKEN=change-me

# LLM Configuration
ENABLE_OLLAMA=false
OLLAMA_MODEL=qwen2.5-coder:7b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# GitHub Apps (Dual-app architecture: reader/scanner vs verified-patch writer)
GITHUB_SCANNER_APP_ID=
GITHUB_SCANNER_PRIVATE_KEY_PATH=/secrets/scanner.pem

# Writer App Key (Mounted ONLY into services/remediation-engine)
GITHUB_WRITER_APP_ID=
GITHUB_WRITER_PRIVATE_KEY_PATH=/secrets/writer.pem

# Audit Log Signing (64-character hex encoded Ed25519 seed or private key)
AUDIT_ED25519_PRIVATE_KEY_HEX=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Optional Neo4j graph visualisation (docker compose --profile neo4j up -d)
# Leave NEO4J_URI empty to disable the export.
NEO4J_URI=
# NEO4J_URI=bolt://neo4j:7687
NEO4J_PASSWORD=guardian_dev_neo4j
